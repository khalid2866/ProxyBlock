<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProxyBlock.App.Views.TeacherHomePage"
             Title="Teacher">
    <VerticalStackLayout Spacing="15" Padding="30" VerticalOptions="Center">
        <Label Text="Attendance session" FontSize="24" FontAttributes="Bold"
               HorizontalOptions="Center" />
        <Entry x:Name="CourseEntry" Placeholder="Course name (e.g. SCD)" />
        <Button x:Name="StartButton" Text="Start session" Clicked="OnStartClicked" />
        <Label x:Name="TokenLabel" FontSize="48" FontAttributes="Bold"
               HorizontalOptions="Center" />
        <Label x:Name="InfoLabel" HorizontalOptions="Center" />
        <Button x:Name="EndButton" Text="End session" Clicked="OnEndClicked"
                IsVisible="False" />
        <Label x:Name="ErrorLabel" TextColor="Red" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
